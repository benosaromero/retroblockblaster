        (Path("job_summary.txt"), Path(run + "_summary.tsv")),
    ]

    for source, target in copies:
        if source.exists() and not target.exists():
            shutil.copyfile(str(source), str(target))


def run_workflow_background(job_id, step, run, db):
    try:
        commands = []

        if step == "retro":
            commands = [([sys.executable, "retro.py", run], "Running retrosynthesis...", 30, "Finding routes and disconnected synthons.")]
        elif step == "bbs":
            commands = [([sys.executable, "bbs.py", "-db", db, run], "Finding matched building blocks...", 55, "Searching building-block matches for each synthon.")]
        elif step == "make":
            commands = [([sys.executable, "make.py", run], "Generating analogs...", 78, "Enumerating analog products.")]
        elif step == "rank":
            commands = [([sys.executable, "rank.py", run], "Ranking analogs...", 95, "Ranking products by similarity.")]
        elif step == "full":
            commands = [
                ([sys.executable, "retro.py", run], "Running retrosynthesis...", 25, "Finding routes and disconnected synthons."),
                ([sys.executable, "bbs.py", "-db", db, run], "Finding matched building blocks...", 50, "Searching building-block matches for each synthon."),
                ([sys.executable, "make.py", run], "Generating analogs...", 75, "Enumerating analog products."),
                ([sys.executable, "rank.py", run], "Ranking analogs...", 95, "Ranking products by similarity."),
            ]
        else:
            write_workflow_status(job_id, "error", "Unknown workflow step: {}".format(step), 0, "")
            return

        for cmd, message, progress, summary in commands:
            if not run_workflow_command(job_id, cmd, message, progress, summary):
                return

            if len(cmd) >= 2 and cmd[1] == "retro.py":
                normalize_retro_outputs(run)

        write_workflow_status(job_id, "done", "{} finished.".format(step), 100, "Outputs are ready to view or download.")

    except Exception as error:
        write_workflow_status(job_id, "error", str(error), 0, "Workflow crashed before finishing.")


@app.post("/api/workflow/start/{step}")
def start_workflow_step(step: str, data: dict):
    run = safe_workflow_name(data.get("run", "mol1"))
    db = data.get("db", "dball")
    job_id = uuid.uuid4().hex[:12]

    if step in ["retro", "full"]:
        clean_workflow_outputs(run)

    write_workflow_status(job_id, "running", "Queued {}...".format(step), 1, "Preparing workflow command.", run=run)

    thread = threading.Thread(target=run_workflow_background, args=(job_id, step, run, db))
    thread.daemon = True
    thread.start()

    return {"job_id": job_id, "step": step, "run": run, "status": "running"}


@app.get("/api/workflow/status/{job_id}")
def workflow_status(job_id: str):
    job_id = safe_workflow_name(job_id)
    path = WORKFLOW_JOB_DIR / (job_id + ".json")

    if not path.exists():
        return {
            "job_id": job_id,
            "status": "running",
            "message": "Waiting for workflow job to start...",
            "progress": 1,
            "summary": "The job has been queued.",
            "done": False,
        }

    try:
        raw_text = path.read_text().strip()
        data = json.loads(raw_text) if raw_text else {}
    except Exception:
        return {
            "job_id": job_id,
            "status": "running",
            "message": "Workflow is updating status...",
            "progress": 1,
            "summary": "",
            "done": False,
        }

    log_path = WORKFLOW_JOB_DIR / (job_id + ".log")
    if log_path.exists():
        try:
            log_text = log_path.read_text(errors="replace")
            data["log"] = log_text[-12000:]
        except Exception:
            data["log"] = ""

    status = data.get("status", "running")
    data["done"] = status in ["done", "finished", "completed", "success", "error"]
    return data


@app.get("/api/workflow/outputs/{run}")
def workflow_outputs(run: str):
    append_workflow_job_index(run)
    outputs = []

    for item in workflow_output_paths(run):
        path = Path(item["path"])
        zip_path = Path("cache") / (item["path"] + ".zip")
        exists = path.exists()
        zip_exists = zip_path.exists()

        row = dict(item)
        row["exists"] = exists or zip_exists
        row["available"] = exists or zip_exists
        row["size"] = path.stat().st_size if exists and path.is_file() else (zip_path.stat().st_size if zip_exists else None)

        if zip_exists and not exists:
            row["cached_zip"] = str(zip_path)

        outputs.append(row)

    return {
        "run": safe_workflow_name(run),
        "outputs": outputs,
        "jobs": workflow_job_rows(run),
    }


def safe_workflow_path(value):
    name = str(value).strip()

    if not name or name.startswith("/") or "\x00" in name:
        raise HTTPException(status_code=400, detail="invalid path")

    path = Path(name)

    if ".." in path.parts:
        raise HTTPException(status_code=400, detail="invalid path")

    return path


def is_product_output_preview(path):
    name = path.name

    return (
        name.endswith("_all.tsv")
        or name.endswith("_rank.tsv")
        or name.endswith("_rank_tc06_all.tsv")
        or name.endswith("_rank_tc04_connected.tsv")
        or name.endswith("enumerated_products.tsv")
    )


