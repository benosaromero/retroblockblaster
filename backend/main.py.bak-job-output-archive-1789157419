WORKFLOW_JOB_INDEX = Path("workflow_job_index.tsv")


def append_workflow_job_index(run):
    run = safe_workflow_name(run)

    rows = []
    seen = set()

    for source_path in [
        Path(run + "_syn.tsv"),
        Path(run + "_jobs.tsv"),
    ]:
        if not source_path.exists():
            continue

        lines = source_path.read_text(errors="replace").splitlines()

        if not lines:
            continue

        header = lines[0].split("\t")

        if "job_id" not in header:
            continue

        job_index = header.index("job_id")
        input_index = header.index("input_id") if "input_id" in header else -1

        for line in lines[1:]:
            parts = line.split("\t")

            if len(parts) <= job_index:
                continue

            job_id = parts[job_index].strip()
            input_id = parts[input_index].strip() if input_index >= 0 and len(parts) > input_index else ""

            if not job_id:
                continue

            key = (job_id, run, input_id)

            if key in seen:
                continue

            seen.add(key)
            rows.append(key)

    if not rows:
        return 0

    existing = set()

    if WORKFLOW_JOB_INDEX.exists():
        for line in WORKFLOW_JOB_INDEX.read_text(errors="replace").splitlines()[1:]:
            parts = line.split("\t")
            if len(parts) >= 3:
                existing.add((parts[0], parts[1], parts[2]))

    needs_header = not WORKFLOW_JOB_INDEX.exists() or WORKFLOW_JOB_INDEX.stat().st_size == 0

    with WORKFLOW_JOB_INDEX.open("a") as output:
        if needs_header:
            output.write("job_id\trun\tinput_id\n")

        wrote = 0

        for row in rows:
            if row in existing:
                continue

            output.write("{}\t{}\t{}\n".format(row[0], row[1], row[2]))
            wrote += 1

    return wrote


