WORKFLOW_JOB_DIR = Path("cache") / "workflow_jobs"
WORKFLOW_JOB_DIR.mkdir(parents=True, exist_ok=True)


def write_workflow_status(job_id, status, message, progress=0, summary="", run=""):
    WORKFLOW_JOB_DIR.mkdir(parents=True, exist_ok=True)
    path = WORKFLOW_JOB_DIR / (job_id + ".json")
    tmp_path = WORKFLOW_JOB_DIR / (job_id + ".json.tmp")

    if not run and path.exists():
        try:
            existing = json.loads(path.read_text())
            run = existing.get("run", "")
        except Exception:
            run = ""

    data = {
        "job_id": job_id,
        "run": run,
        "status": status,
        "message": message,
        "progress": progress,
        "summary": summary,
    }

    tmp_path.write_text(json.dumps(data, indent=2))
    tmp_path.replace(path)


def run_workflow_command(job_id, cmd, message, progress, summary):
    write_workflow_status(job_id, "running", message, progress, summary)

    log_path = WORKFLOW_JOB_DIR / (job_id + ".log")
    with log_path.open("a") as log:
        log.write("\\n\\n$ {}\\n".format(" ".join(cmd)))
        log.flush()

        process = subprocess.Popen(cmd, stdout=log, stderr=log)
        return_code = process.wait()

    if return_code != 0:
        write_workflow_status(job_id, "error", "Failed: " + message, progress, "See workflow log: {}".format(log_path))
        return False

    return True


