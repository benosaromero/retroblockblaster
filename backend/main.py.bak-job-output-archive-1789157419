def render_tsv_preview(path, max_rows=200):
    import csv
    from urllib.parse import quote

    rows = []

    with path.open("r", errors="replace") as handle:
        reader = csv.reader(handle, delimiter="\t" if path.suffix.lower() != ".csv" else ",")

        for index, row in enumerate(reader):
            rows.append(row)

            if index >= max_rows:
                break

    if not rows:
        return workflow_page(path.name, "<p>No rows found.</p>")

    header = rows[0]
    existing_svg_for = set()

    for column in header:
        if column.endswith("_svg"):
            existing_svg_for.add(column[:-4])

    preview_header = []

    for column in header:
        base_name = column[:-7] if column.endswith("_smiles") else column

        if (column == "smiles" or column.endswith("_smiles")) and base_name not in existing_svg_for:
            preview_header.append(base_name + "_svg")

        preview_header.append(column)

    table_rows = []
    table_rows.append(
        "<tr>{}</tr>".format(
            "".join("<th>{}</th>".format(html_escape(str(value))) for value in preview_header)
        )
    )

    for row in rows[1:]:
        rendered_cells = []

        for column_index, column in enumerate(header):
            raw_value = row[column_index] if column_index < len(row) else ""
            safe_value = html_escape(str(raw_value))
            base_name = column[:-7] if column.endswith("_smiles") else column

            if column.endswith("_svg"):
                if raw_value:
                    rendered_cells.append(
                        "<td class='workflow-svg-cell'><img class='workflow-preview-mol' src='/{}' alt='Molecule structure'></td>".format(
                            quote(str(raw_value).lstrip("/"))
                        )
                    )
                else:
                    rendered_cells.append("<td></td>")
                continue

            if column == "smiles" or column.endswith("_smiles"):
                if base_name not in existing_svg_for:
                    if raw_value:
                        rendered_cells.append(
                            "<td class='workflow-svg-cell'><img class='workflow-preview-mol' src='/draw?smiles={}' alt='Molecule structure'></td>".format(
                                quote(str(raw_value))
                            )
                        )
                    else:
                        rendered_cells.append("<td></td>")

                rendered_cells.append("<td class='smiles-text'>{}</td>".format(safe_value))
                continue

            rendered_cells.append("<td>{}</td>".format(safe_value))

        table_rows.append("<tr>{}</tr>".format("".join(rendered_cells)))

    body = """
<div class="rb2-table-scroll">
  <table class="preview-table preview-table-wide">{}</table>
</div>
""".format("".join(table_rows))

    return workflow_page(path.name, body)


def render_json_preview(path):
    data = json.loads(path.read_text())

    body = "<pre class='smiles-text'>{}</pre>".format(
        html_escape(json.dumps(data, indent=2, sort_keys=True))
    )

    return workflow_page(path.name, body)


def render_product_tsv_preview(path):
    return render_tsv_preview(path)


def render_product_json_preview(path):
    return render_json_preview(path)


@app.get("/workflow-view-file/{filename:path}", response_class=HTMLResponse)
def workflow_view_file(filename: str):
    path = safe_workflow_path(filename)

    if not path.exists() or not path.is_file():
        return HTMLResponse("file not found", status_code=404)

    suffix = path.suffix.lower()

    if suffix == ".svg":
        return FileResponse(path, media_type="image/svg+xml")

    if suffix == ".png":
        return FileResponse(path, media_type="image/png")

    if suffix in [".tsv", ".csv", ".txt"]:
        if is_product_output_preview(path):
            return HTMLResponse(render_product_tsv_preview(path))
        return HTMLResponse(render_tsv_preview(path))

    if suffix == ".json":
        if is_product_output_preview(path):
            return HTMLResponse(render_product_json_preview(path))
        return HTMLResponse(render_json_preview(path))

    return FileResponse(path)


@app.get("/workflow-view-folder/{folder:path}", response_class=HTMLResponse)
def workflow_view_folder(folder: str):
    path = safe_workflow_path(folder)

    if not path.exists() or not path.is_dir():
        return HTMLResponse("folder not found", status_code=404)

    rows = ["<tr><th>name</th><th>type</th><th>actions</th></tr>"]

    for child in sorted(path.iterdir()):
        full = str(child)
        if child.is_dir():
            actions = "<a class='button-link preview-mini-link' href='/workflow-view-folder/{}'>Open</a>".format(quote(full))
            kind = "folder"
        else:
            actions = "<a class='button-link preview-mini-link' href='/workflow-view-file/{}' target='_blank'>View</a> <a class='button-link preview-mini-link' href='/workflow-artifact/{}'>Download</a>".format(
                quote(full),
                quote(full),
            )
            kind = "file"

        rows.append("<tr><td>{}</td><td>{}</td><td>{}</td></tr>".format(html_escape(child.name), kind, actions))

    body = """
<div class="rb2-table-scroll">
  <table class="preview-table preview-table-wide">{}</table>
</div>
""".format("".join(rows))

    return workflow_page(str(path), body)


