BETA_BACKEND = "http://127.0.0.1:8001"


def proxy_beta_get(path):
    with urlopen(BETA_BACKEND + path, timeout=120) as response:
        return json.loads(response.read().decode("utf-8"))


def proxy_beta_post(path, payload):
    from urllib.error import HTTPError, URLError

    url = "http://127.0.0.1:8001{}".format(path)
    body = json.dumps(payload).encode("utf-8")

    request = Request(
        url,
        data=body,
        headers={"Content-Type": "application/json"},
        method="POST",
    )

    try:
        with urlopen(request, timeout=300) as response:
            return json.loads(response.read().decode("utf-8"))
    except HTTPError as error:
        error_body = error.read().decode("utf-8", errors="replace")
        return {
            "error": "beta endpoint returned HTTP {}".format(error.code),
            "beta_path": path,
            "beta_body": error_body,
        }
    except URLError as error:
        return {
            "error": "could not connect to beta endpoint",
            "beta_path": path,
            "details": str(error),
        }

def add_tc_scores(reference_smiles, results):
    if not reference_smiles or not results:
        return results

    payload = json.dumps({
        "reference_smiles": reference_smiles,
        "candidates": results,
    }).encode("utf-8")

    process = subprocess.Popen(
        ["/nfs/exj/Fe/scripts/common_db/arthor-env/bin/python", "backend/tc_score_cli.py"],
        stdin=subprocess.PIPE,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
    )

    stdout, stderr = process.communicate(payload)

    if process.returncode != 0:
        return results

    try:
        return json.loads(stdout.decode("utf-8"))
    except Exception:
        return results


def safe_workflow_name(value):
    run = str(value).strip()

    if not run:
        raise HTTPException(status_code=400, detail="missing run name")

    if run.endswith(".tsv"):
        run = run[:-4]

    allowed = []
    for char in run:
        if char.isalnum() or char in "-_":
            allowed.append(char)

    cleaned = "".join(allowed)

    if cleaned != run:
        raise HTTPException(
            status_code=400,
            detail="Run name can only contain letters, numbers, dash, and underscore",
        )

    return cleaned


def run_workflow_command(command):
    completed = subprocess.run(
        command,
        stdout=subprocess.PIPE,
        stderr=subprocess.PIPE,
        universal_newlines=True,
    )

    if completed.returncode != 0:
        raise HTTPException(
            status_code=500,
            detail=completed.stderr or completed.stdout or "Workflow command failed",
        )

    return completed.stdout.strip()



@app.post("/api/workflow/upload-input")
async def upload_workflow_input(file: UploadFile = File(...)):
    name = file.filename or ""
    suffix = Path(name).suffix.lower()
    content = await file.read()

    rows = []

    if suffix in [".tsv", ".txt", ".csv"]:
        text = content.decode("utf-8", errors="replace")
        delimiter = "," if suffix == ".csv" else "\t"

        import csv
        from io import StringIO

        reader = csv.DictReader(StringIO(text), delimiter=delimiter)
        for row in reader:
            cid = str(row.get("id", "")).strip()
            smiles = str(row.get("smiles", "")).strip()
            if cid and smiles:
                rows.append({"id": cid, "smiles": smiles})

    elif suffix in [".xlsx", ".xls"]:
        from io import BytesIO
        from openpyxl import load_workbook

        workbook = load_workbook(BytesIO(content), read_only=True, data_only=True)
        sheet = workbook.active
        values = list(sheet.iter_rows(values_only=True))

        if not values:
            return {"error": "spreadsheet is empty", "rows": []}

        headers = [str(value).strip().lower() if value is not None else "" for value in values[0]]

        if "id" not in headers or "smiles" not in headers:
            return {"error": "spreadsheet must have columns named id and smiles", "rows": []}

        id_index = headers.index("id")
        smiles_index = headers.index("smiles")

        for values_row in values[1:]:
            cid = str(values_row[id_index]).strip() if values_row[id_index] is not None else ""
            smiles = str(values_row[smiles_index]).strip() if values_row[smiles_index] is not None else ""
            if cid and smiles:
                rows.append({"id": cid, "smiles": smiles})

    else:
        return {"error": "upload .xlsx, .xls, .tsv, .csv, or .txt only", "rows": []}

    return {
        "filename": name,
        "count": len(rows),
        "rows": rows,
    }



