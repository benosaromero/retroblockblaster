def job_file_path(job_id, *parts):
    local_path = Path("jobs") / job_id
    legacy_path = LEGACY_JOB_ROOT / job_id

    local_file = local_path.joinpath(*parts)
    if local_file.exists():
        return local_file

    legacy_file = legacy_path.joinpath(*parts)
    if legacy_file.exists():
        return legacy_file

    return local_file


